<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RifeControl</AssemblyName>
    <Product>RIFE for PotPlayer</Product>
    <Title>RIFE for PotPlayer</Title>
    <Description>RIFE for PotPlayer</Description>
    <RootNamespace>RifeControl</RootNamespace>
    <StartupObject>RifeControl.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <ApplicationVersion>0.3.0</ApplicationVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Controller.cs"/>
    <Compile Include="ResolutionSettings.cs"/>
    <Compile Include="DiagnosticsText.cs"/>
    <Compile Include="DiagnosticsScrollTests.cs"/>
    <EmbeddedResource Include="MainWindow.xaml" LogicalName="MainWindow.xaml"/>
    <EmbeddedResource Include="ResolutionWindow.xaml" LogicalName="ResolutionWindow.xaml"/>
  </ItemGroup>
</Project>
